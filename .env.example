# Copy to `.env` and fill in. `.env` is gitignored and is never loaded into the
# shell automatically — run `source .env` before any command that talks to the
# Threads API. `npm run server` and `node db/migrate.ts` load it themselves.

# Threads. THREADS_APP_ID is the *Threads* app id, not the Meta one.
THREADS_ACCESS_TOKEN=
THREADS_APP_ID=
THREADS_APP_SECRET=

# Drafting. Without this `agent.ts generate` and POST /api/generate refuse to run.
ANTHROPIC_API_KEY=

# Generation history and analytics. Optional — everything works without it,
# the history simply is not kept. Port matches docker-compose.yml.
POSTGRES_PORT=55432
POSTGRES_USER=threads
POSTGRES_PASSWORD=threads
POSTGRES_DB=threads_agent
DATABASE_URL=postgres://threads:threads@127.0.0.1:55432/threads_agent

# Only for a deployment that binds beyond loopback — /api can publish and delete.
# HOST=0.0.0.0
# THREADS_AGENT_TOKEN=
