[Unit]
Description=Take the Threads post readings that are due
Documentation=https://github.com/rayofgoodness/threads-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/home/pi/Projects/threads-agent
EnvironmentFile=/home/pi/Projects/threads-agent/.env

# Without DATABASE_URL the sweep exits having made no API call at all, so this
# unit is harmless on a deployment that runs no database.
Environment=THREADS_AGENT_NODE=/usr/bin/node
ExecStart=/home/pi/Projects/threads-agent/scripts/collect-metrics.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Off because the deployment lives under /home; see threads-agent.service.
ProtectHome=false
ReadWritePaths=/home/pi/Projects/threads-agent/content

SyslogIdentifier=threads-agent-metrics
