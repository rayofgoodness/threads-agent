[Unit]
Description=Take the Threads post readings that are due
Documentation=https://github.com/rayofgoodness/threads-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=threads
Group=threads
WorkingDirectory=/opt/threads-agent
EnvironmentFile=/opt/threads-agent/.env

# Without DATABASE_URL the sweep exits having made no API call at all, so this
# unit is harmless on a deployment that runs no database.
Environment=THREADS_AGENT_NODE=/usr/bin/node
ExecStart=/opt/threads-agent/scripts/collect-metrics.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/threads-agent/content

SyslogIdentifier=threads-agent-metrics
