[Unit]
Description=Publish whatever the Threads queue says is due
Documentation=https://github.com/rayofgoodness/threads-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/home/pi/Projects/threads-agent
EnvironmentFile=/home/pi/Projects/threads-agent/.env

# The wrapper resolves node and loads .env itself, which matters under cron;
# systemd already provides both, so it costs nothing and keeps one entry point.
Environment=THREADS_AGENT_NODE=/usr/bin/node
ExecStart=/home/pi/Projects/threads-agent/scripts/publish-due.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Off because the deployment lives under /home; see threads-agent.service.
ProtectHome=false
ReadWritePaths=/home/pi/Projects/threads-agent/content

SyslogIdentifier=threads-agent-publish
