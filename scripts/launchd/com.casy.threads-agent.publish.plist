<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.casy.threads-agent.publish</string>

  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/scripts/publish-due.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <!-- Every 15 minutes rather than at the configured slots: the queue decides
       what is due, the daily cap bounds it, and a laptop that was asleep at
       09:30 still publishes when it wakes. -->
  <key>StartInterval</key>
  <integer>900</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__REPO__/content/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/content/launchd.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
